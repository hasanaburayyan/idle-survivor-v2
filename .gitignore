# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output / framework caches
dist/
*.tsbuildinfo
.expo/
.expo-shared/
web-build/

# Local env (never commit secrets / per-machine config)
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Claude agent local memory (per-machine notes, never shared)
.claude/agent-memory/
**/.claude/agent-memory/

# Obsidian per-workspace state
.obsidian/workspace.json

# Terraform — provider cache + state. Lock files (.terraform.lock.hcl) are
# intentionally NOT ignored: they pin provider versions and should be committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Per-machine / auto-loaded tfvars only — checked-in terraform.tfvars files
# (e.g. domain_name) are public config and stay tracked.
*.auto.tfvars
*.auto.tfvars.json

# SpacetimeDB generated client bindings — regenerate with `spacetime generate`
src/module_bindings/
